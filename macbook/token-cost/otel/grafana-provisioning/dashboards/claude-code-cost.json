{
  "uid": "claude-code-cost",
  "title": "Claude Code cost",
  "tags": [
    "claude-code",
    "tokens"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "arm",
        "label": "Arm",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_token_usage_tokens_total, arm)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_token_usage_tokens_total, model)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cost (notional USD)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{arm=~\"$arm\", model=~\"$model\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Sessions",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_session_count_total{arm=~\"$arm\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Cost per session",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{arm=~\"$arm\", model=~\"$model\"}[$__range])) / clamp_min(sum(increase(claude_code_session_count_total{arm=~\"$arm\"}[$__range])), 1)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Cache read share of tokens",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\", arm=~\"$arm\", model=~\"$model\"}[$__range])) / sum(increase(claude_code_token_usage_tokens_total{arm=~\"$arm\", model=~\"$model\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Cache write share of relative cost",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(1.25 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\", arm=~\"$arm\", model=~\"$model\"}[$__range]))) / ((1 * sum(increase(claude_code_token_usage_tokens_total{type=\"input\", arm=~\"$arm\", model=~\"$model\"}[$__range]))) + (1.25 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\", arm=~\"$arm\", model=~\"$model\"}[$__range]))) + (0.1 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\", arm=~\"$arm\", model=~\"$model\"}[$__range]))) + (5 * sum(increase(claude_code_token_usage_tokens_total{type=\"output\", arm=~\"$arm\", model=~\"$model\"}[$__range]))))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.35
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "title": "Active time",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total{arm=~\"$arm\"}[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "title": "Cost per hour by model",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{arm=~\"$arm\", model=~\"$model\"}[1h]))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Relative cost by token type (approx.)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Weights over the input price: input 1, cache write 1.25 (5m and 1h are not split in the metric), cache read 0.1, output 5. Shows where the bill goes, not dollars.",
      "targets": [
        {
          "expr": "1 * sum(increase(claude_code_token_usage_tokens_total{type=\"input\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "input",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        },
        {
          "expr": "1.25 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "cache write",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        },
        {
          "expr": "0.1 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "cache read",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        },
        {
          "expr": "5 * sum(increase(claude_code_token_usage_tokens_total{type=\"output\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))",
          "legendFormat": "output",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9aa4b5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache write"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d98a3d"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache read"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3d5a8a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6b7a59"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Cache write share of relative cost",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Above about 25% for several days usually means cache misses (model switch, MCP or plugin changes, idle past the TTL).",
      "targets": [
        {
          "expr": "(1.25 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))) / ((1 * sum(increase(claude_code_token_usage_tokens_total{type=\"input\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))) + (1.25 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheCreation\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))) + (0.1 * sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))) + (5 * sum(increase(claude_code_token_usage_tokens_total{type=\"output\", arm=~\"$arm\", model=~\"$model\"}[$__rate_interval]))))",
          "legendFormat": "cache write share",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#b4540a"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        }
      }
    },
    {
      "id": 10,
      "title": "Cost by arm",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Compare RTK/Caveman configurations through the OTEL_RESOURCE_ATTRIBUTES `arm` label.",
      "targets": [
        {
          "expr": "sum by (arm) (increase(claude_code_cost_usage_USD_total{arm=~\"$arm\", model=~\"$model\"}[1h]))",
          "legendFormat": "{{arm}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "By model",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{arm=~\"$arm\", model=~\"$model\"}[$__range]))",
          "refId": "cost",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{type=\"output\", arm=~\"$arm\", model=~\"$model\"}[$__range]))",
          "refId": "out",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{type=\"cacheRead\", arm=~\"$arm\", model=~\"$model\"}[$__range]))",
          "refId": "cr",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "model",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #cost": "Cost (USD)",
              "Value #out": "Output tokens",
              "Value #cr": "Cache read tokens"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(Output|Cache read) tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Cost (USD)",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 12,
      "title": "Slowest API requests",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | event_name=\"api_request\" | duration_ms > 0",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Events",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service_name=\"claude-code\"} | event_name=~\"api_request|tool_result|api_error\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
