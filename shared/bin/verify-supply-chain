#!/usr/bin/env bun
// Proves every dependency-download guard still blocks what it should.
// Each check matches the guard's own error text, so a network error or a
// missing tool never counts as a pass. Exits 1 on any FAIL.
// Installs only into temp dirs, and removes anything that slipped through.
import { mkdtempSync, rmSync, existsSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join } from "node:path";

const HOME = process.env.HOME!;
const XDG = process.env.XDG_CONFIG_HOME ?? join(HOME, ".config");
const MALWARE = "safe-chain-test@0.0.1-security"; // a test package Socket flags as malware
const NOSCAN = Bun.which("bun-noscan") ?? join(HOME, ".local/bin/bun-noscan");
const SOCKET_ADVISORY = /socket\.dev\/npm\/package\/safe-chain-test/;
type Status = "PASS" | "FAIL" | "SKIP";
const results: { name: string; status: Status }[] = [];

function record(name: string, status: Status, detail = "") {
  results.push({ name, status });
  console.log(`${status}  ${name}${detail ? `  (${detail})` : ""}`);
}
function check(name: string, ok: boolean, why: string) {
  record(name, ok ? "PASS" : "FAIL", ok ? "" : why);
}
function run(cmd: string[], opts: { cwd?: string; env?: Record<string, string | undefined>; stdin?: string } = {}) {
  try {
    const p = Bun.spawnSync(cmd, {
      cwd: opts.cwd,
      env: opts.env ?? process.env,
      stdin: opts.stdin === undefined ? "ignore" : new Blob([opts.stdin]),
      stdout: "pipe",
      stderr: "pipe",
    });
    return { code: p.exitCode, out: p.stdout.toString() + p.stderr.toString() };
  } catch (e) {
    return { code: 127, out: String(e) };
  }
}
const tail = (s: string) => s.trim().split("\n").slice(-2).join(" | ").slice(0, 160);
function tempDir() {
  return mkdtempSync(join(tmpdir(), "verify-sc-"));
}
async function project() {
  const dir = tempDir();
  await Bun.write(join(dir, "package.json"), JSON.stringify({ name: "verify", private: true }));
  return dir;
}
const cleanup = (dir: string) => rmSync(dir, { recursive: true, force: true });

// Preflight: without the registries and the Socket API every guard "blocks", so stop.
for (const url of ["https://registry.npmjs.org/-/ping", "https://pypi.org/simple/pip/", "https://firewall-api.socket.dev/"]) {
  try {
    await fetch(url, { method: "HEAD", signal: AbortSignal.timeout(10_000) });
  } catch {
    console.error(`Cannot reach ${url}. Run this online: offline, every check would pass for the wrong reason.`);
    process.exit(1);
  }
}

// A version published in the last `days` days, to test the cooldowns with.
async function freshNpm(pkg: string, days = 7) {
  const meta = (await (await fetch(`https://registry.npmjs.org/${pkg}`)).json()) as { time: Record<string, string> };
  const cutoff = Date.now() - days * 86400e3;
  return Object.entries(meta.time).filter(([v, t]) => !["created", "modified"].includes(v) && Date.parse(t) > cutoff).at(-1)?.[0] ?? null;
}
async function freshPypi(pkg: string, days = 7) {
  const meta = (await (await fetch(`https://pypi.org/pypi/${pkg}/json`)).json()) as {
    releases: Record<string, { upload_time_iso_8601: string }[]>;
  };
  const cutoff = Date.now() - days * 86400e3;
  return Object.entries(meta.releases).filter(([, f]) => f[0] && Date.parse(f[0].upload_time_iso_8601) > cutoff).at(-1)?.[0] ?? null;
}

// 1. Bun's scanner blocks malware.
{
  const dir = await project();
  const r = run(["bun", "add", MALWARE], { cwd: dir });
  check("bun blocks malware (Socket scanner)", r.code !== 0 && SOCKET_ADVISORY.test(r.out), tail(r.out));
  cleanup(dir);
}

// 2. mise npm: tools (aube) block malware with no shell setup at all. PATH keeps
// only the system dirs and the global Node, which the scanner bridge needs (22.6+).
{
  const dir = tempDir();
  await Bun.write(join(dir, "mise.toml"), `[tools]\n"npm:safe-chain-test" = { version = "0.0.1-security", allow_low_downloads = true }\n`);
  run(["mise", "trust", "-q", dir]);
  const node = run(["mise", "which", "-C", HOME, "node"]).out.trim().split("\n")[0];
  const env = {
    HOME,
    PATH: [existsSync(node) ? dirname(node) : "", "/usr/bin", "/bin", "/opt/homebrew/bin", "/usr/local/bin"].filter(Boolean).join(":"),
    XDG_CONFIG_HOME: process.env.XDG_CONFIG_HOME,
    MISE_GLOBAL_CONFIG_FILE: process.env.MISE_GLOBAL_CONFIG_FILE,
  };
  const r = run(["mise", "-C", dir, "install", "npm:safe-chain-test"], { env });
  const blocked = r.code !== 0 && SOCKET_ADVISORY.test(r.out);
  if (!blocked) run(["mise", "-C", dir, "uninstall", "npm:safe-chain-test@0.0.1-security"], { env });
  check("mise npm: blocks malware without a shell (aube scanner)", blocked, tail(r.out));
  cleanup(dir);
}

// 3. 7-day cooldowns.
const tsFresh = await freshNpm("typescript");
if (!tsFresh) record("cooldown checks (bun, npm)", "FAIL", "no typescript version from the last 7 days to test with");
else {
  const dir = await project();
  const b = run(["bun", "add", `typescript@${tsFresh}`], { cwd: dir });
  check(`bun cooldown refuses typescript@${tsFresh}`, /minimum-release-age/.test(b.out), tail(b.out));
  const n = run(["npm", "install", "--dry-run", "--no-audit", "--no-fund", `typescript@${tsFresh}`], { cwd: dir });
  check(`npm cooldown refuses typescript@${tsFresh}`, /ETARGET[\s\S]*with a date before/.test(n.out), tail(n.out));
  for (const pnpm of ["10", "latest"]) {
    const p = ["mise", "x", "-C", HOME, `pnpm@${pnpm}`, "--", "pnpm"];
    if (run([...p, "--version"]).code !== 0) record(`pnpm@${pnpm} cooldown`, "SKIP", "pnpm not available through mise");
    else {
      const r = run([...p, "add", `typescript@${tsFresh}`], { cwd: dir });
      check(`pnpm@${pnpm} cooldown refuses typescript@${tsFresh}`, /minimumReleaseAge/.test(r.out), tail(r.out));
    }
  }
  cleanup(dir);
}
{
  const uv = ["mise", "x", "-C", HOME, "uv@latest", "--", "uv"];
  const pyFresh = await freshPypi("boto3");
  if (run([...uv, "--version"]).code !== 0) record("uv cooldown", "SKIP", "uv not available through mise");
  else if (!pyFresh) record("uv cooldown", "FAIL", "no boto3 version from the last 7 days to test with");
  else {
    const dir = tempDir();
    const r = run([...uv, "pip", "compile", "--no-header", "-"], { cwd: dir, stdin: `boto3==${pyFresh}\n` });
    check(`uv cooldown refuses boto3==${pyFresh}`, /filtered by `exclude-newer`/.test(r.out), tail(r.out));
    cleanup(dir);
  }
}

// 4. npm refuses install scripts nobody approved.
{
  const dir = await project();
  const r = run(["npm", "install", "--no-audit", "--no-fund", "esbuild@0.24.0"], { cwd: dir });
  check("npm refuses unapproved postinstall (strict-allow-scripts)", /ESTRICTALLOWSCRIPTS[\s\S]*esbuild/.test(r.out), tail(r.out));
  cleanup(dir);
}

// 5. bun-noscan drops the scanner but keeps the cooldown.
{
  const dir = await project();
  const a = run([NOSCAN, "add", MALWARE], { cwd: dir });
  const installed = a.code === 0 && existsSync(join(dir, "node_modules/safe-chain-test"));
  check("bun-noscan skips the scanner", installed, tail(a.out));
  if (tsFresh) {
    const c = run([NOSCAN, "add", `typescript@${tsFresh}`], { cwd: dir });
    check("bun-noscan keeps the cooldown", /minimum-release-age/.test(c.out), tail(c.out));
  }
  cleanup(dir);
}

// 6. Agent CLIs don't update themselves, so they change only through `mise upgrade`.
const text = async (p: string) => ((await Bun.file(p).exists()) ? Bun.file(p).text() : "");
const json = async (p: string) => JSON.parse((await text(p)) || "{}");
const claude = await json(join(HOME, ".claude/settings.json"));
check("claude self-update off", claude.env?.DISABLE_AUTOUPDATER === "1" && claude.env?.DISABLE_UPDATES === "1", "~/.claude/settings.json env");
check("codex self-update off", /^check_for_update_on_startup\s*=\s*false/m.test(await text(join(HOME, ".codex/config.toml"))), "~/.codex/config.toml");
check("copilot self-update off", (await json(join(HOME, ".copilot/config.json"))).autoUpdate === false, "~/.copilot/config.json");
check("gemini self-update off", (await json(join(HOME, ".gemini/settings.json"))).general?.enableAutoUpdate === false, "~/.gemini/settings.json");
check("opencode self-update off", (await json(join(XDG, "opencode/opencode.json"))).autoupdate === false, "opencode.json");
check("grok self-update off", /\[cli\][^[]*auto_update\s*=\s*false/.test(await text(join(HOME, ".grok/config.toml"))), "~/.grok/config.toml");
// A new terminal in the user's own shell (login + interactive: macOS reads ~/.bash_profile) gets the variable from takashi's rc files (stdout only: bash -i chatters on stderr)
const shellEnv = Bun.spawnSync([process.env.SHELL || "bash", "-lic", 'printf "%s" "$COPILOT_AUTO_UPDATE"'], { stdin: "ignore", stdout: "pipe", stderr: "ignore" })
  .stdout.toString().trim();
check("copilot self-update off in interactive shells (COPILOT_AUTO_UPDATE)", shellEnv === "false", `got "${shellEnv}"`);

const failed = results.filter((r) => r.status === "FAIL");
const skipped = results.filter((r) => r.status === "SKIP");
console.log(`\n${results.length - failed.length - skipped.length} passed, ${failed.length} failed, ${skipped.length} skipped`);
if (failed.length) {
  console.error(`Guards failing open or missing: ${failed.map((f) => f.name).join("; ")}`);
  process.exit(1);
}
