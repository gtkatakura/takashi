#!/usr/bin/env bash
# Run bun without the security scanner: offline work and scanner bootstrap only.
# Keeps the cooldown from the real bunfig. Child processes still see every other
# config entry, through a per-run mirror of $XDG_CONFIG_HOME.
set -euo pipefail
real="${XDG_CONFIG_HOME:-$HOME/.config}"
bunfig="$real/.bunfig.toml"
[ -f "$bunfig" ] || bunfig="$HOME/.bunfig.toml"
# No bunfig yet on a fresh machine: fall back to 7 days
age=$({ sed -n 's/^minimumReleaseAge *= *\([0-9]*\).*/\1/p' "$bunfig" 2>/dev/null || true; } | head -n1)
mkdir -p "$HOME/.local/state"
mirror="$(mktemp -d "$HOME/.local/state/bun-noscan.XXXXXX")"
trap 'rm -rf "$mirror"' EXIT
for entry in "$real"/* "$real"/.[!.]*; do
  [ -e "$entry" ] || continue
  [ "${entry##*/}" = .bunfig.toml ] && continue
  ln -s "$entry" "$mirror/${entry##*/}"
done
printf '[install]\nminimumReleaseAge = %s\n' "${age:-604800}" >"$mirror/.bunfig.toml"
echo "bun-noscan: security scanner OFF for this command" >&2
XDG_CONFIG_HOME="$mirror" bun "$@"
