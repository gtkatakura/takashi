#!/bin/bash
# One Flatpak Steam per account: each account gets its own HOME under ~/.steam-accounts/<name>,
# so sessions, config and ~/.steam never collide.
set -euo pipefail

accounts_dir="$HOME/.steam-accounts"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
applications="$data_home/applications"

accounts() {
  local dir name
  echo labs
  for dir in "$accounts_dir"/*/; do
    name="$(basename "$dir")"
    if account_exists "$name"; then echo "$name"; fi
  done
}

usage() {
  echo "usage: steam-account <name> [steam args...]" >&2
  echo "       steam-account list | add <name> | remove <name>" >&2
  echo "accounts: $(accounts | xargs)" >&2
  exit 1
}

fail() {
  echo "steam-account: $1" >&2
  exit 1
}

# Names are lowercase ASCII, and cannot be labs or a subcommand: those would never reach the account
valid_name() {
  # C locale: otherwise [a-z] also matches accented letters
  local LC_ALL=C
  [[ "$1" =~ ^[a-z0-9][a-z0-9_.-]*$ && ! "$1" =~ ^(labs|list|add|remove)$ ]]
}

# A link is not an account: remove would delete the link and leave the games where they are
account_exists() {
  valid_name "$1" && [ -d "$accounts_dir/$1" ] && [ ! -L "$accounts_dir/$1" ]
}

# Every Flatpak Steam has D-Bus proxies from the moment it starts, carrying the account's HOME.
# One can outlive its Steam, which only makes remove more careful
steam_proxies() {
  pgrep -u "$(id -u)" -x xdg-dbus-proxy --env "HOME=$1"
}

add_account() {
  valid_name "$1" || fail "invalid account name: $1"
  mkdir -p "$accounts_dir/$1" "$applications"
  # No actions: the ones in the Flatpak export run without the account's HOME and would open labs
  cat >"$applications/steam-$1.desktop" <<DESKTOP
[Desktop Entry]
Name=Steam - $1
Comment=Steam on the $1 account
Exec=$HOME/.local/bin/steam-account $1
Icon=com.valvesoftware.Steam
Type=Application
Categories=Game;
DESKTOP
  echo "Added $1: open it with steam-account $1 and log in with \"remember me\""
}

remove_account() {
  local home="$accounts_dir/$1" answer=""
  account_exists "$1" || fail "unknown account: $1"
  steam_proxies "$home" >/dev/null && fail "$1 is still running: close its Steam, or see flatpak ps"
  IFS= read -rp "Delete $home and its installed games? Type CONFIRM: " answer || true
  [ "$answer" = CONFIRM ] || fail "$1 not removed"
  # Again: it may have started while the prompt was open
  steam_proxies "$home" >/dev/null && fail "$1 is still running: close its Steam, or see flatpak ps"
  # The launcher entry goes first, so it cannot open the account while it is being deleted
  rm -f "$applications/steam-$1.desktop"
  rm -rf -- "$home"
}

# A running Steam ignores a second launch while one of its games runs, so open its window from its
# tray icon. The icons look the same: the one to click is owned by a Flatpak proxy with this HOME.
show_window() {
  local proxies item service path pid id
  proxies=$(steam_proxies "$1") || return 1
  for item in $(busctl --user --json=short get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null | jq -r '.data[]'); do
    service="${item%%/*}"
    path="/${item#*/}"
    [[ "$path" == */steam ]] || continue
    pid=$(busctl --user status "$service" 2>/dev/null | sed -n 's/^PID=//p')
    grep -qx "$pid" <<<"$proxies" || continue

    # Library, found from the end: the menu closes with Store, Library, Community | Friends, Settings |
    # Big Picture, SteamVR, Exit Steam, in any language and below any recent games. Exit Steam is in
    # the last group, which this cannot reach
    id=$(busctl --user --json=short call "$service" "$path/Menu" com.canonical.dbusmenu GetLayout iias 0 1 0 | jq -r '
      .data[1][2] | map(.data) | [to_entries[] | select(.value[1].type.data == "separator") | .key] as $seps
      | if ($seps | length) >= 2 then .[$seps[-2] - 2][0] else empty end')
    [ -n "$id" ] || return 1
    busctl --user call "$service" "$path/Menu" com.canonical.dbusmenu Event isvu "$id" clicked i 0 0
    return
  done
  return 1
}

case "${1:-}" in
  "") usage ;;
  list)
    accounts
    exit
    ;;
  add)
    add_account "${2:-}"
    exit
    ;;
  remove)
    remove_account "${2:-}"
    exit
    ;;
esac

name="$1"
shift

if [ "$name" = labs ]; then
  # labs is the default Flatpak Steam, which keeps the real HOME
  home="$HOME"
else
  # A typo must not bootstrap a new Steam: accounts only come from steam-account add
  account_exists "$name" || usage
  home="$accounts_dir/$name"
fi

[ $# -eq 0 ] && show_window "$home" && exit 0

# Every sandbox starts Steam at the same PID, and Steam names its UI socket (/tmp/steam_chrome_shmem_*)
# and shared memory after that PID, in the /tmp and /dev/shm all Flatpak Steams share: the last Steam
# to start takes them, and the others never open a window. So each account burns 1000 PIDs per
# position in the list first; labs, at 0, matches a plain flatpak run
slot=$(accounts | grep -nxF "$name" | cut -d: -f1)
skip=$(((slot - 1) * 1000))

# XDG_DATA_HOME keeps the real per-user Flatpak installation visible under the new HOME
exec env HOME="$home" XDG_DATA_HOME="$data_home" flatpak run --user --command=bash com.valvesoftware.Steam \
  -c 'for ((i = 0; i < $0; i++)); do (:); done; exec steam "$@"' "$skip" "$@"
