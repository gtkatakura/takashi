#!/bin/bash
# One Flatpak Steam per account: each account gets its own HOME under ~/.steam-accounts/<name>,
# so sessions, config and ~/.steam never collide.
set -euo pipefail

accounts_dir="$HOME/.steam-accounts"
applications="$HOME/.local/share/applications"

accounts() {
  echo labs
  find "$accounts_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort || true
}

usage() {
  echo "usage: steam-account <name> [steam args...]" >&2
  echo "       steam-account list | add <name> | remove <name>" >&2
  echo "accounts: $(accounts | xargs)" >&2
  exit 1
}

fail() {
  echo "steam-account: $1" >&2
  exit 1
}

valid_name() {
  # C locale: otherwise [a-z] also matches accented letters
  local LC_ALL=C
  [[ "$1" =~ ^[a-z0-9][a-z0-9_.-]*$ && ! "$1" =~ ^(labs|list|add|remove)$ ]]
}

account_exists() {
  valid_name "$1" && [ -d "$accounts_dir/$1" ]
}

# Every Flatpak Steam has a D-Bus proxy from the moment it starts, carrying the account's HOME
is_steam_proxy() {
  [ "$(cat "/proc/$1/comm" 2>/dev/null)" = xdg-dbus-proxy ] && grep -zxFq "HOME=$2" "/proc/$1/environ" 2>/dev/null
}

steam_running() {
  local pid
  for pid in $(pgrep -u "$(id -u)" -x xdg-dbus-proxy); do
    is_steam_proxy "$pid" "$1" && return
  done
  return 1
}

add_account() {
  valid_name "$1" || fail "invalid account name: $1"
  mkdir -p "$accounts_dir/$1" "$applications"
  # No actions: the ones in the Flatpak export run without the account's HOME and would open labs
  cat >"$applications/steam-$1.desktop" <<DESKTOP
[Desktop Entry]
Name=Steam - $1
Comment=Steam on the $1 account
Exec=$HOME/.local/bin/steam-account $1
Icon=com.valvesoftware.Steam
Type=Application
Categories=Game;
DESKTOP
  echo "Added $1: open it with steam-account $1 and log in with \"remember me\""
}

remove_account() {
  local home="$accounts_dir/$1" answer=""
  account_exists "$1" || fail "unknown account: $1"
  ! steam_running "$home" || fail "close the $1 Steam first"
  IFS= read -rp "Delete $home and its installed games? Type CONFIRM: " answer || true
  [ "$answer" = CONFIRM ] || fail "$1 not removed"
  # Again: it may have started while the prompt was open
  ! steam_running "$home" || fail "close the $1 Steam first"
  rm -rf -- "$home"
  rm -f "$applications/steam-$1.desktop"
}

# A running Steam ignores a second launch while one of its games runs, so open its window from its
# tray icon. The icons look the same: the one to click is owned by a Flatpak proxy with this HOME.
show_window() {
  local item service path pid id
  for item in $(busctl --user --json=short get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
    org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null | jq -r '.data[]'); do
    service="${item%%/*}"
    path="/${item#*/}"
    [[ "$path" == */steam ]] || continue
    pid=$(busctl --user status "$service" 2>/dev/null | sed -n 's/^PID=//p')
    is_steam_proxy "$pid" "$1" || continue

    # By label, never by position: Exit Steam sits in the same menu. Steam translates the labels
    id=$(gdbus call --session --dest "$service" --object-path "$path/Menu" --method com.canonical.dbusmenu.GetLayout 0 1 '[]' |
      sed 's/<(/\n<(/g' | grep -E "'label': <'(Library|Biblioteca)'>" | grep -oE '^<\([0-9]+' | tr -d '<(')
    [ -n "$id" ] || return 1
    gdbus call --session --dest "$service" --object-path "$path/Menu" --method com.canonical.dbusmenu.Event \
      "$id" "'clicked'" '<int32 0>' 0 >/dev/null
    return
  done
  return 1
}

case "${1:-}" in
  "") usage ;;
  list)
    accounts
    exit
    ;;
  add)
    add_account "${2:-}"
    exit
    ;;
  remove)
    remove_account "${2:-}"
    exit
    ;;
esac

name="$1"
shift

if [ "$name" = labs ]; then
  # labs is the default Flatpak Steam, which keeps the real HOME
  home="$HOME"
else
  # A typo must not bootstrap a new Steam: accounts only come from steam-account add
  account_exists "$name" || usage
  home="$accounts_dir/$name"
fi

[ $# -eq 0 ] && show_window "$home" && exit 0

# XDG_DATA_HOME keeps the real per-user Flatpak installation visible under the new HOME
exec env HOME="$home" XDG_DATA_HOME="$HOME/.local/share" flatpak run --user com.valvesoftware.Steam "$@"
